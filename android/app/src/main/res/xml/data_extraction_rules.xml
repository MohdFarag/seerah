<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later. Content packages can be downloaded again, so they are never backed up
  (ADR 0003). Whether user data is backed up is an open decision (docs/open-decisions.md);
  until it is decided, user data follows the platform default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="content/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="content/" />
    </device-transfer>
</data-extraction-rules>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map trial edits",
  "$comment": "Copied from content/schema/content.schema.json $defs at commit ceb7df4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "purpose",
    "edits"
  ],
  "properties": {
    "schema": {
      "const": "trial-0"
    },
    "purpose": {
      "const": "trial"
    },
    "edits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edit"
      }
    }
  },
  "$defs": {
    "review": {
      "description": "Owner review state. Only 'approved' may ship; the build refuses anything else, including 'title-approved' (ADR 0007).",
      "enum": [
        "title-approved",
        "draft",
        "in-review",
        "approved"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "work",
        "locator"
      ],
      "properties": {
        "kind": {
          "enum": [
            "quran",
            "hadith",
            "seerah-book",
            "atlas",
            "shamail",
            "commentary"
          ]
        },
        "work": {
          "type": "string",
          "description": "e.g. صحيح البخاري, سيرة ابن هشام"
        },
        "edition": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "surah:ayah, hadith number, volume/page"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "geometry",
        "operation",
        "feather_m",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "geometry": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "Polygon"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 4,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "LineString"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          ]
        },
        "operation": {
          "enum": [
            "raise",
            "flatten-to",
            "carve"
          ]
        },
        "amount_m": {
          "type": "number"
        },
        "height_m": {
          "type": "number"
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "feather_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "raise",
                  "carve"
                ]
              }
            }
          },
          "then": {
            "required": [
              "amount_m"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "flatten-to"
              }
            }
          },
          "then": {
            "required": [
              "height_m"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "carve"
              }
            }
          },
          "then": {
            "required": [
              "width_m"
            ],
            "properties": {
              "amount_m": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    }
  }
}

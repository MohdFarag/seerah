# Newest releases at least 14 days old on 2026-11-23 (PyPI upload dates in comments).
# Transitive pins in requirements.txt are the recorded exception to the 14-day rule.
# To regenerate requirements.txt from the repository root:
#
#   docker run --rm --user "$(id -u):$(id -g)" --security-opt label=disable \
#     -e UV_CACHE_DIR=/tmp/uv --tmpfs /tmp \
#     -e UV_CUSTOM_COMPILE_COMMAND='see the command in tools/packages/requirements.in' \
#     --mount type=image,src=ghcr.io/astral-sh/uv:0.13.6,dst=/uvimg \
#     -v "$PWD/tools/packages:/m" -w /m ghcr.io/al-seerah/seerah-map:e752be682c117fd4 \
#     /uvimg/uv pip compile --universal --python-version 3.11 \
#       --generate-hashes requirements.in -o requirements.txt

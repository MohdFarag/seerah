# Copy to .env and fill in. Never commit .env.
# None of these are decided yet (see docs/open-decisions.md). Placeholders only.

# Content package update endpoint (provider not chosen yet)
CONTENT_UPDATE_URL=

# Feedback delivery endpoint (mechanism not decided yet)
FEEDBACK_ENDPOINT=

# Usage analytics (tool not chosen; must stay off until the scope is finalized)
ANALYTICS_ENABLED=false
ANALYTICS_KEY=

# Android release signing (local only; in CI use repository secrets)
SEERAH_KEYSTORE_PATH=
SEERAH_KEYSTORE_PASSWORD=
SEERAH_KEY_ALIAS=
SEERAH_KEY_PASSWORD=
